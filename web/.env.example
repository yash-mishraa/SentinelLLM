# SentinelLLM Web Dashboard Environment Configuration
# SECURITY INVARIANT:
# NEVER prefix backend API keys with NEXT_PUBLIC_!
# All sensitive credentials must remain server-side only in Next.js Route Handlers.

# Python FastAPI backend URL (BACKEND_URL is also accepted as an alias in cloud hosting)
SENTINELLLM_API_URL=http://127.0.0.1:8000

# Backend API Keys (Used by Server-Side BFF route handlers)
# These match the default development keys configured in src/sentinelllm/api/auth.py
SENTINELLLM_ADMIN_KEY=sentinel-admin-key-secret
SENTINELLLM_SUPERVISOR_KEY=sentinel-supervisor-key-secret
SENTINELLLM_ANALYST_KEY=sentinel-analyst-key-secret
SENTINELLLM_GUEST_KEY=sentinel-guest-key-secret

# Session secret for cookie HMAC-SHA256 signing (at least 32 characters in production)
SESSION_SECRET=dev-session-signing-secret-random-32chars
