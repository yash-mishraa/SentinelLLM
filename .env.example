# SentinelLLM Environment Configuration (Example)
# Copy this file to .env for local development. Never commit .env.

# Application Environment
SENTINELLLM_ENV=development
SENTINELLLM_LOG_LEVEL=INFO

# Runtime Policy Engine Settings
SENTINELLLM_STRICT_MODE=false
SENTINELLLM_MAX_TOOL_CALL_DEPTH=5

# Audit and Telemetry
SENTINELLLM_AUDIT_ENABLED=true
SENTINELLLM_AUDIT_LOG_PATH=logs/audit.jsonl

# PromptProbe Evaluation Settings
PROMPTPROBE_BENCHMARK_OUTPUT_DIR=benchmarks/results
PROMPTPROBE_RANDOM_SEED=42
