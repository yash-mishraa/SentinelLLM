# SentinelLLM Environment Configuration (Example)
# Copy this file to .env for local development. Never commit .env.

# Application Environment
SENTINELLLM_ENV=development
SENTINELLLM_LOG_LEVEL=INFO

# Runtime Policy Engine Settings
SENTINELLLM_STRICT_MODE=false
SENTINELLLM_MAX_TOOL_CALL_DEPTH=5

# Audit and Telemetry
SENTINELLLM_AUDIT_ENABLED=true
SENTINELLLM_AUDIT_LOG_PATH=logs/audit.jsonl

# PromptProbe Evaluation Settings
PROMPTPROBE_BENCHMARK_OUTPUT_DIR=benchmarks/results
PROMPTPROBE_RANDOM_SEED=42

# Database Persistence (PostgreSQL in production; SQLite fallback in development)
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinelllm
# SENTINELLLM_DATABASE_URL=sqlite:///sentinelllm_dev.db

# API Gateway Authentication Keys (Hex or high-entropy secrets)
# SENTINELLLM_ADMIN_KEY=sentinel-admin-key-secret
# SENTINELLLM_SUPERVISOR_KEY=sentinel-supervisor-key-secret
# SENTINELLLM_ANALYST_KEY=sentinel-analyst-key-secret
# SENTINELLLM_GUEST_KEY=sentinel-guest-key-secret

# Distributed Rate Limiting & Networking
# SENTINELLLM_RATE_LIMIT_ENABLED=true
# SENTINELLLM_API_PORT=8000
# SENTINELLLM_CORS_ORIGINS=["http://localhost:3000"]
